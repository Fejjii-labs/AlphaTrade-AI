#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

head=$(git rev-parse HEAD)
check=false
while read -r local_ref local_oid remote_ref remote_oid; do
  [[ "$local_ref" == '(delete)' ]] && continue
  if [[ "$local_oid" != "$head" ]]; then
    printf 'Check out %s before pushing it with the local CI hook.\n' "$local_ref" >&2
    exit 1
  fi
  check=true
done

if [[ "$check" == true ]]; then
  if [[ -n "$(git status --porcelain)" ]]; then
    printf 'Commit or stash working-tree changes before pushing with the local CI hook.\n' >&2
    exit 1
  fi
  exec bash scripts/ci-local.sh
fi
