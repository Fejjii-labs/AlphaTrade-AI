# ---------------------------------------------------------------------------
# AlphaTrade AI - example environment configuration
# Copy to `.env` and adjust. SAFE DEFAULTS: paper mode, real trading disabled.
# See also: `.env.docker.example`, `.env.staging.example`
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="AlphaTrade AI"
ENVIRONMENT=local            # local | staging | production
DEBUG=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false               # JSON logs (true) or console-friendly (false)

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Trading safety (DO NOT enable real trading in this scaffold) ---
# execution_mode: paper | read_only | trade
EXECUTION_MODE=paper
# Hard kill switch for any real exchange execution. Must be true AND
# EXECUTION_MODE=trade for live orders. Keep false.
ENABLE_REAL_TRADING=false
# Ops emergency gate (AT-014). When true, all execution is blocked regardless of
# organization kill-switch rows. Keep false unless responding to an incident.
GLOBAL_KILL_SWITCH_ACTIVE=false

# --- Exchange connectivity (Slice 56A — demo only; independent of EXECUTION_MODE) ---
# exchange_mode: paper_internal | paper_exchange_demo | trade_live
#   paper_internal      — pure in-database simulation (default, no exchange calls)
#   paper_exchange_demo — route paper orders to a BloFin DEMO account (not real money)
#   trade_live          — PERMANENTLY BLOCKED; selecting it refuses startup
EXCHANGE_MODE=paper_internal
BLOFIN_DEMO_ENABLED=false
# Env-only credentials for a single shared BloFin demo account. Leave blank unless
# EXCHANGE_MODE=paper_exchange_demo. Never commit real values.
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_API_PASSPHRASE=
# Must be an allowlisted BloFin demo host over HTTPS/WSS (production hosts rejected).
BLOFIN_DEMO_REST_BASE_URL=
BLOFIN_DEMO_WS_URL=
BLOFIN_REQUEST_TIMEOUT_SECONDS=10
BLOFIN_MAX_RETRIES=2
BLOFIN_RATE_LIMIT_REQUESTS_PER_SECOND=5

# --- Data stores ---
# Local development (services on localhost):
DATABASE_URL=postgresql+psycopg://alphatrade:alphatrade@localhost:5432/alphatrade
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Docker Compose (uncomment when running `docker compose up`):
# DATABASE_URL=postgresql+psycopg://alphatrade:alphatrade@postgres:5432/alphatrade
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333

# --- Providers (leave credentials blank for mock/fallback mode) ---
# provider_mode:
#   mock     — deterministic mocks only (default, safe for tests)
#   fallback — try OpenAI/Qdrant when configured; fall back to mocks if unavailable
#   live     — same as fallback (real trading still disabled)
PROVIDER_MODE=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Conversational Agent and capture use the same frontier model, without mock prose fallback.
AGENT_REASONING_MODEL=gpt-6-astra
AGENT_REASONING_EFFORT=high
AGENT_MAX_OUTPUT_TOKENS=25000
# Phase 2 model router (typed purposes; callers cannot elevate to Tier A).
LLM_TIER_A_MODEL=gpt-4o
LLM_TIER_B_MODEL=gpt-4o-mini
MODEL_ROUTER_POLICY_VERSION=model-router/v1
MODEL_ROUTER_FAIL_CLOSED=false
EMBEDDINGS_MODEL=text-embedding-3-small
# Optional. Auto: 384 (mock) or model native size when OPENAI_API_KEY is set
# (1536 for text-embedding-3-small). Set explicitly after switching providers.
# EMBEDDINGS_DIMENSIONS=1536
# Qdrant Cloud / authenticated deployments:
# QDRANT_API_KEY=

# --- Background worker (Slice 59 — disabled by default; never trades) ---
WORKER_ENABLED=false
# process = dedicated worker service; in_process = daemon thread inside the API
WORKER_MODE=process
WORKER_NAME=alphatrade-worker
WORKER_SCAN_INTERVAL_SECONDS=60
WORKER_LOCK_TTL_SECONDS=120
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
# Worker system alerts (Slice 60 — outbound only; Telegram can never trade).
# Requires ALERT_DELIVERY_ENABLED=true and TELEGRAM_ALERTS_ENABLED=true to send.
WORKER_ALERTS_ENABLED=false
WORKER_ALERT_MIN_SEVERITY=info        # info | warning | critical
WORKER_QUIET_HOURS_START=             # "HH:MM" UTC; empty disables quiet hours
WORKER_QUIET_HOURS_END=

# --- Market data (read-only) ---
MARKET_DATA_ENABLED=true
MARKET_DATA_PROVIDER=binance
MARKET_DATA_CACHE_USE_REDIS=true
# Phase 5 first-slice evidence. Local/CI default is replay (no network).
# Staging's intended source is binance_usdm. See docs/live_market_staging_activation.md.
# Live USD-M is read-only public REST. Spot fallback is forbidden.
PERPETUAL_EVIDENCE_SOURCE=replay
PERPETUAL_EVIDENCE_TIMEOUT_SECONDS=10
# AT-069 tick-on-read monitor. Does not start Watcher. Live source remains opt-in.
PERPETUAL_MONITOR_POLL_SECONDS=2
PERPETUAL_MONITOR_BACKOFF_INITIAL_SECONDS=0.25
PERPETUAL_MONITOR_BACKOFF_MAX_SECONDS=30

# --- Observability (optional) ---
OBSERVABILITY_STRICT_MODE=false
# AT-016 RED metrics (disabled by default; token required outside local)
METRICS_ENABLED=false
METRICS_SCRAPE_TOKEN=
LANGSMITH_API_KEY=

# --- Authentication ---
JWT_SECRET=change-me-in-production-use-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Bearer mode (local dev default):
AUTH_REFRESH_COOKIE_ENABLED=false
AUTH_OMIT_REFRESH_FROM_BODY=true
# Cookie mode (Docker / staging / production — see .env.staging.example):
# AUTH_REFRESH_COOKIE_ENABLED=true
# AUTH_COOKIE_SECURE=false          # true in staging/production (HTTPS)
# AUTH_COOKIE_SAMESITE=lax          # none for cross-domain Vercel + API
# ACCESS_TOKEN_DENYLIST_ENABLED=true
# ACCESS_TOKEN_DENYLIST_USE_REDIS=true

# --- Email (Slice 25 — mock default) ---
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=noreply@alphatrade.local
EMAIL_BASE_URL=http://localhost:3000
EMAIL_SEND_ENABLED=true
# REQUIRE_EMAIL_VERIFIED=          # unset: local=false, staging/production=true
# EMAIL_AUTO_VERIFY_LOCAL=false

# --- Billing (Slice 26 — disabled by default) ---
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- TradingView signal intake (AT-037 — disabled by default; paper-only) ---
TRADINGVIEW_WEBHOOK_ENABLED=false
TRADINGVIEW_WEBHOOK_SECRET=
TRADINGVIEW_WEBHOOK_MAX_SKEW_SECONDS=300
TRADINGVIEW_WEBHOOK_RATE_LIMIT=60
TRADINGVIEW_WEBHOOK_RATE_WINDOW_SECONDS=3600
TRADINGVIEW_AUTO_CREATE_CANDIDATE=false

# --- BloFin demo read-only sync (AT-037 — never places orders) ---
BLOFIN_SYNC_STALE_AFTER_SECONDS=300
BLOFIN_SYNC_MAX_POSITIONS=50
BLOFIN_SYNC_MAX_BALANCES=50
# Off until explicitly enabled. A disarmed worker never attaches this cycle.
BLOFIN_DEMO_SNAPSHOT_SYNC_ENABLED=false
# Worker read-only snapshot cadence in seconds. Allowed range 30-60.
BLOFIN_DEMO_SNAPSHOT_SYNC_SECONDS=45

# --- Internal paper stop/target exit monitor (default off; not set on Render) ---
# Closes canonical internal paper trades when a closed candle touches the stop
# or target. Does not touch BloFin demo trades and does not place orders.
# PAPER_EXIT_MONITOR_ENABLED defaults false. Production refuses it.
# PAPER_EXIT_MONITOR_DRY_RUN defaults true: an unset variable logs the close
# and does not write. Live internal-paper closes require an explicit false.
PAPER_EXIT_MONITOR_ENABLED=false
PAPER_EXIT_MONITOR_DRY_RUN=true

# --- Watcher orchestration foundation (Phase 7 worker; disabled by default) ---
# Isolated from the legacy MARKET_WATCHER scanner. Must remain false in
# staging/production. Local paper Watcher runtime may set true only in
# ENVIRONMENT=local; that is rejected by deployment_safety elsewhere.
WATCHER_ORCHESTRATION_ENABLED=false
WATCHER_LEASE_TTL_SECONDS=30
WATCHER_HEARTBEAT_STALE_AFTER_SECONDS=90
WATCHER_PAPER_SYMBOLS=BTCUSDT
# Legacy local/test file helper only; production API and worker use organization-owned database rows.
WATCHER_WATCHLIST_PATH=
WATCHER_PAPER_POLL_INTERVAL_SECONDS=15
WATCHER_PAPER_MAX_SCOPES_PER_CYCLE=20
WATCHER_PAPER_WORKER_ID=watcher-paper-1

# Isolated Telegram interaction protocol (AT-043 — disabled; not wired to HTTP or execution)
TELEGRAM_INTERACTION_ENABLED=false
# Controlled paper activation (AT-077). Leave disarmed. Do not permit network delivery.
TELEGRAM_PAPER_ACTIVATION_ARMED=false
TELEGRAM_INBOUND_MODE=off
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_NETWORK_PERMITTED=false
# Verified private binding ids. Empty until a human arms the paper package.
TELEGRAM_BOT_ID=
TELEGRAM_CHAT_ID=
# Comma-separated safety-alert codes allowed on Telegram (monitor-health codes omitted by default).
# TELEGRAM_SAFETY_ALERT_ALLOWLIST=kill_switch_activated,stop_hit,tp_hit

# --- Paper-signal orchestration (AT-038 — paper-only; disabled by default) ---
PAPER_SIGNAL_ORCHESTRATION_ENABLED=false
# observe_only | candidate_only | approval_required (no live/autonomous mode)
PAPER_SIGNAL_ORCHESTRATION_MODE=observe_only
PAPER_SIGNAL_MAX_AGE_SECONDS=900
PAPER_SIGNAL_MIN_CONFIDENCE=0.0
PAPER_SIGNAL_REQUIRE_SETUP_WHEN_NAMED=true
PAPER_SIGNAL_REQUIRE_STRATEGY_WHEN_PROVIDED=true
PAPER_SIGNAL_ALLOWED_TIMEFRAMES=1m,3m,5m,15m,30m,1h,2h,4h,6h,12h,1d,3d,1w
PAPER_SIGNAL_COOLDOWN_AFTER_LOSS_SECONDS=3600
PAPER_SIGNAL_CONFLICT_WINDOW_SECONDS=3600
PAPER_SIGNAL_DEFAULT_POSITION_SIZE=0.001
PAPER_SIGNAL_DEFAULT_LEVERAGE=1.0
PAPER_SIGNAL_CREATE_RUN_PLAN=true

BILLING_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing?checkout=success
BILLING_CHECKOUT_CANCEL_URL=http://localhost:3000/billing?checkout=cancel
BILLING_PORTAL_RETURN_URL=http://localhost:3000/billing

# --- Rate limiting ---
RATE_LIMIT_USE_REDIS=true
# In-memory fallback is a local-only convenience; staging/production require
# Redis and reject fallback=true at startup (AT-018).
RATE_LIMIT_ALLOW_IN_MEMORY_FALLBACK=true

# --- Proxy trust (AT-018) ---
# Trusted reverse proxies in front of the app. 0 = ignore X-Forwarded-For
# entirely (safe local default); deployments behind one proxy (Render) use 1.
TRUSTED_PROXY_HOPS=0

# --- Journal completion (AT-033) ---
# Opt-in auto-journal hooks; both default false. When enabled, closing a paper
# position / paper-validation trade also records a canonical journal trade.
JOURNAL_AUTO_FROM_POSITION_CLOSE=false
JOURNAL_AUTO_FROM_PAPER_VALIDATION=false
# Attachment limits (DB-backed storage; fail-closed validation).
JOURNAL_ATTACHMENT_MAX_BYTES=5242880
JOURNAL_ATTACHMENT_ALLOWED_TYPES=image/png,image/jpeg,image/webp,application/pdf
JOURNAL_ATTACHMENT_MAX_PER_TRADE=20
