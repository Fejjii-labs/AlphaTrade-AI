{
  "$defs": {
    "BookLevel": {
      "additionalProperties": false,
      "properties": {
        "base_quantity": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Base Quantity",
          "type": "string"
        },
        "price": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Price",
          "type": "string"
        }
      },
      "required": [
        "price",
        "base_quantity"
      ],
      "title": "BookLevel",
      "type": "object"
    },
    "ContractStyle": {
      "enum": [
        "linear",
        "inverse"
      ],
      "title": "ContractStyle",
      "type": "string"
    },
    "DataCompleteness": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "title": "DataCompleteness",
      "type": "string"
    },
    "DerivativeMetric": {
      "enum": [
        "open_interest",
        "funding"
      ],
      "title": "DerivativeMetric",
      "type": "string"
    },
    "DerivativeObservation": {
      "additionalProperties": false,
      "description": "Identity includes instrument, venue, market, provider and native timeframe.\n\nMissing event times stay null; observation time never substitutes for them.\nFunding is a dimensionless settled rate, without annualization or an assumed\n8h interval. OI is never combined across venues or quantity conventions.",
      "properties": {
        "availability": {
          "$ref": "#/$defs/EvidenceAvailability"
        },
        "calculation_method": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Calculation Method",
          "type": "string"
        },
        "collected_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collected At"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "coverage_kind": {
          "const": "single_provider_record",
          "default": "single_provider_record",
          "title": "Coverage Kind",
          "type": "string"
        },
        "event_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Event Time"
        },
        "freshness": {
          "anyOf": [
            {
              "$ref": "#/$defs/FreshnessEvaluation"
            },
            {
              "type": "null"
            }
          ]
        },
        "freshness_policy_version": {
          "maxLength": 80,
          "minLength": 3,
          "title": "Freshness Policy Version",
          "type": "string"
        },
        "historical_coverage": {
          "const": false,
          "default": false,
          "title": "Historical Coverage",
          "type": "boolean"
        },
        "identity": {
          "$ref": "#/$defs/EvidenceMarketIdentity"
        },
        "methodology_version": {
          "const": "provider-reported-derivatives/v2",
          "default": "provider-reported-derivatives/v2",
          "title": "Methodology Version",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/DerivativeMetric"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "units": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Units",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "metric",
        "identity",
        "event_time",
        "observed_at",
        "freshness",
        "freshness_policy_version",
        "units",
        "calculation_method",
        "availability",
        "value",
        "content_hash"
      ],
      "title": "DerivativeObservation",
      "type": "object"
    },
    "EvidenceAvailability": {
      "enum": [
        "AVAILABLE",
        "MISSING",
        "STALE",
        "UNSUPPORTED",
        "INCOMPLETE"
      ],
      "title": "EvidenceAvailability",
      "type": "string"
    },
    "EvidenceMarketIdentity": {
      "additionalProperties": false,
      "description": "Full identity required on every first-slice evidence object.",
      "properties": {
        "instrument": {
          "$ref": "#/$defs/InstrumentIdentity"
        },
        "market_type": {
          "$ref": "#/$defs/MarketType"
        },
        "provenance": {
          "$ref": "#/$defs/ProviderProvenance"
        },
        "source": {
          "$ref": "#/$defs/SourceIdentity"
        },
        "timeframe": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timeframe"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "venue": {
          "$ref": "#/$defs/VenueId"
        }
      },
      "required": [
        "venue",
        "market_type",
        "instrument",
        "source",
        "provenance"
      ],
      "title": "EvidenceMarketIdentity",
      "type": "object"
    },
    "FiveMinuteFlow": {
      "additionalProperties": false,
      "properties": {
        "aggressive_buy_base_volume": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Aggressive Buy Base Volume",
          "type": "string"
        },
        "aggressive_buy_quote_volume": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Aggressive Buy Quote Volume",
          "type": "string"
        },
        "aggressive_sell_base_volume": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Aggressive Sell Base Volume",
          "type": "string"
        },
        "aggressive_sell_quote_volume": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Aggressive Sell Quote Volume",
          "type": "string"
        },
        "buy_sell_imbalance_ratio": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Buy Sell Imbalance Ratio"
        },
        "event_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Event Time"
        },
        "quote_volume_delta": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Quote Volume Delta",
          "type": "string"
        },
        "rolling_cvd": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Rolling Cvd",
          "type": "string"
        },
        "rolling_quote_cvd": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Rolling Quote Cvd",
          "type": "string"
        },
        "signed_volume_delta": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Signed Volume Delta",
          "type": "string"
        },
        "terminal_price": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Terminal Price"
        },
        "trade_count": {
          "minimum": 0,
          "title": "Trade Count",
          "type": "integer"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "window_start",
        "window_end",
        "aggressive_buy_base_volume",
        "aggressive_sell_base_volume",
        "aggressive_buy_quote_volume",
        "aggressive_sell_quote_volume",
        "signed_volume_delta",
        "quote_volume_delta",
        "trade_count",
        "buy_sell_imbalance_ratio",
        "rolling_cvd",
        "rolling_quote_cvd",
        "event_time",
        "terminal_price"
      ],
      "title": "FiveMinuteFlow",
      "type": "object"
    },
    "FreshnessEvaluation": {
      "additionalProperties": false,
      "properties": {
        "age_seconds": {
          "ge": 0,
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Age Seconds",
          "type": "string"
        },
        "clock_skew_seconds": {
          "ge": 0,
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Clock Skew Seconds",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "policy_version": {
          "maxLength": 80,
          "minLength": 3,
          "title": "Policy Version",
          "type": "string"
        },
        "source_time": {
          "format": "date-time",
          "title": "Source Time",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/FreshnessState"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "policy_version",
        "evaluated_at",
        "source_time",
        "age_seconds",
        "valid_until",
        "state",
        "clock_skew_seconds",
        "content_hash"
      ],
      "title": "FreshnessEvaluation",
      "type": "object"
    },
    "FreshnessState": {
      "enum": [
        "fresh",
        "aging",
        "stale",
        "gap",
        "unknown"
      ],
      "title": "FreshnessState",
      "type": "string"
    },
    "InstrumentIdentity": {
      "additionalProperties": false,
      "description": "Canonical perpetual instrument identity; independent of provider symbol formatting.",
      "properties": {
        "base_asset": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Base Asset",
          "type": "string"
        },
        "base_quantity_unit": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Base Quantity Unit",
          "type": "string"
        },
        "contract_multiplier": {
          "gt": 0,
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Contract Multiplier",
          "type": "string"
        },
        "contract_style": {
          "$ref": "#/$defs/ContractStyle"
        },
        "instrument_id": {
          "maxLength": 80,
          "minLength": 8,
          "title": "Instrument Id",
          "type": "string"
        },
        "market_type": {
          "$ref": "#/$defs/MarketType"
        },
        "price_unit": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Price Unit",
          "type": "string"
        },
        "product_family": {
          "$ref": "#/$defs/ProductFamily"
        },
        "provider_symbol": {
          "maxLength": 32,
          "minLength": 2,
          "title": "Provider Symbol",
          "type": "string"
        },
        "quote_asset": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Quote Asset",
          "type": "string"
        },
        "quote_quantity_unit": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Quote Quantity Unit",
          "type": "string"
        },
        "settlement_asset": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Settlement Asset",
          "type": "string"
        },
        "venue": {
          "$ref": "#/$defs/VenueId"
        }
      },
      "required": [
        "venue",
        "market_type",
        "product_family",
        "contract_style",
        "instrument_id",
        "provider_symbol",
        "base_asset",
        "quote_asset",
        "settlement_asset",
        "contract_multiplier",
        "price_unit",
        "base_quantity_unit",
        "quote_quantity_unit"
      ],
      "title": "InstrumentIdentity",
      "type": "object"
    },
    "MarketType": {
      "enum": [
        "perpetual",
        "spot",
        "delivery",
        "coin_m_perpetual",
        "option"
      ],
      "title": "MarketType",
      "type": "string"
    },
    "OrderBookObservation": {
      "additionalProperties": false,
      "properties": {
        "ask_base_quantity": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ask Base Quantity"
        },
        "ask_quote_notional": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ask Quote Notional"
        },
        "asks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BookLevel"
          },
          "title": "Asks",
          "type": "array"
        },
        "availability": {
          "$ref": "#/$defs/EvidenceAvailability"
        },
        "base_units": {
          "title": "Base Units",
          "type": "string"
        },
        "bid_base_quantity": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bid Base Quantity"
        },
        "bid_quote_notional": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bid Quote Notional"
        },
        "bids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BookLevel"
          },
          "title": "Bids",
          "type": "array"
        },
        "calculation_method": {
          "default": "visible-resting-depth/base-and-unrounded-quote/v1",
          "title": "Calculation Method",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "coverage_kind": {
          "const": "depth_limited_snapshot",
          "default": "depth_limited_snapshot",
          "title": "Coverage Kind",
          "type": "string"
        },
        "cross_sequence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cross Sequence"
        },
        "event_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Time"
        },
        "excluded_liquidity": {
          "const": "RPI",
          "default": "RPI",
          "title": "Excluded Liquidity",
          "type": "string"
        },
        "freshness": {
          "anyOf": [
            {
              "$ref": "#/$defs/FreshnessEvaluation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "freshness_policy_version": {
          "default": "resting-book/event-age-10s/no-future/v1",
          "title": "Freshness Policy Version",
          "type": "string"
        },
        "historical_coverage": {
          "const": false,
          "default": false,
          "title": "Historical Coverage",
          "type": "boolean"
        },
        "identity": {
          "$ref": "#/$defs/EvidenceMarketIdentity"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "price_units": {
          "title": "Price Units",
          "type": "string"
        },
        "provider_generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Generated At"
        },
        "quote_units": {
          "title": "Quote Units",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "requested_depth": {
          "const": 20,
          "default": 20,
          "title": "Requested Depth",
          "type": "integer"
        },
        "resting_base_imbalance_ratio": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resting Base Imbalance Ratio"
        },
        "sequence_status": {
          "default": "independent_snapshot",
          "enum": [
            "independent_snapshot",
            "resync_required"
          ],
          "title": "Sequence Status",
          "type": "string"
        },
        "spread": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spread"
        },
        "update_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Update Id"
        }
      },
      "required": [
        "identity",
        "observed_at",
        "collected_at",
        "availability",
        "base_units",
        "quote_units",
        "price_units",
        "content_hash"
      ],
      "title": "OrderBookObservation",
      "type": "object"
    },
