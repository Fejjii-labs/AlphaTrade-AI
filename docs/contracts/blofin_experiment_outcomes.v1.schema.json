{
  "$defs": {
    "ExperimentPerformance": {
      "additionalProperties": false,
      "properties": {
        "account_history_complete": {
          "const": false,
          "default": false,
          "title": "Account History Complete",
          "type": "boolean"
        },
        "contract_version": {
          "const": "blofin-experiment-performance/v1",
          "default": "blofin-experiment-performance/v1",
          "title": "Contract Version",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "fee_cost": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fee Cost"
        },
        "funding": {
          "default": null,
          "title": "Funding",
          "type": "null"
        },
        "methodology_version": {
          "const": "attributable-native-outcomes/v1",
          "default": "attributable-native-outcomes/v1",
          "title": "Methodology Version",
          "type": "string"
        },
        "native_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Native Uid"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        },
        "outcomes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NativeOutcome"
          },
          "title": "Outcomes",
          "type": "array"
        },
        "realized_pnl_after_fees_excluding_funding": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Realized Pnl After Fees Excluding Funding"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "reported_realized_pnl": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Realized Pnl"
        },
        "required_sample_count": {
          "minimum": 1,
          "title": "Required Sample Count",
          "type": "integer"
        },
        "rounding": {
          "const": "18_decimal_places_half_even",
          "default": "18_decimal_places_half_even",
          "title": "Rounding",
          "type": "string"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "sample_group_id": {
          "format": "uuid",
          "title": "Sample Group Id",
          "type": "string"
        },
        "source": {
          "const": "blofin_demo",
          "default": "blofin_demo",
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "variant_key": {
          "title": "Variant Key",
          "type": "string"
        },
        "version_id": {
          "format": "uuid",
          "title": "Version Id",
          "type": "string"
        },
        "win_rate": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
