        "adapter_version": {
          "maxLength": 80,
          "minLength": 3,
          "title": "Adapter Version",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "fallback_used": {
          "title": "Fallback Used",
          "type": "boolean"
        },
        "is_live": {
          "title": "Is Live",
          "type": "boolean"
        },
        "is_mock": {
          "title": "Is Mock",
          "type": "boolean"
        },
        "provider_name": {
          "maxLength": 80,
          "minLength": 3,
          "title": "Provider Name",
          "type": "string"
        },
        "regional_failure": {
          "default": false,
          "title": "Regional Failure",
          "type": "boolean"
        },
        "source_family": {
          "$ref": "#/$defs/SourceFamily"
        }
      },
      "required": [
        "provider_name",
        "source_family",
        "adapter_version",
        "is_live",
        "fallback_used",
        "is_mock"
      ],
      "title": "ProviderProvenance",
      "type": "object"
    },
    "PublicMarketObservation": {
      "additionalProperties": false,
      "description": "Global public venue fact. No tenant owner.",
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        },
        "finality": {
          "$ref": "#/$defs/Finality"
        },
        "freshness_state": {
          "$ref": "#/$defs/FreshnessState"
        },
        "identity": {
          "$ref": "#/$defs/EvidenceMarketIdentity"
        },
        "interval_end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval End"
        },
        "interval_start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Start"
        },
        "observation_id": {
          "format": "uuid",
          "title": "Observation Id",
          "type": "string"
        },
        "observation_type": {
          "$ref": "#/$defs/ObservationType"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "payload_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Content Hash",
          "type": "string"
        },
        "privacy_class": {
          "$ref": "#/$defs/PrivacyClass",
          "default": "public_market_data"
        },
        "receive_time": {
          "format": "date-time",
          "title": "Receive Time",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "source_event_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Source Event Id",
          "type": "string"
        },
        "source_time": {
          "format": "date-time",
          "title": "Source Time",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "identity",
        "observation_type",
        "source_event_id",
        "event_time",
        "source_time",
        "observed_at",
        "receive_time",
        "finality",
        "revision",
        "freshness_state",
        "payload_content_hash",
        "content_hash",
        "recorded_at"
      ],
      "title": "PublicMarketObservation",
      "type": "object"
    },
    "SourceFamily": {
      "enum": [
        "binance_usdm_futures_public",
        "bybit_usdt_perpetual_public",
        "replay_fixture"
