        "adapter_version": {
          "maxLength": 80,
          "minLength": 3,
          "title": "Adapter Version",
          "type": "string"
        },
        "aggressor_convention": {
          "maxLength": 120,
          "minLength": 3,
          "title": "Aggressor Convention",
          "type": "string"
        },
        "family": {
          "$ref": "#/$defs/SourceFamily"
        },
        "provider_name": {
          "maxLength": 80,
          "minLength": 3,
          "title": "Provider Name",
          "type": "string"
        }
      },
      "required": [
        "family",
        "provider_name",
        "adapter_version",
        "aggressor_convention"
      ],
      "title": "SourceIdentity",
      "type": "object"
    },
    "Timeframe": {
      "description": "Supported candle timeframes.",
      "enum": [
        "1m",
        "3m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "4h",
        "6h",
        "12h",
        "1d",
        "3d",
        "1w"
      ],
      "title": "Timeframe",
      "type": "string"
    },
    "TradeDirection": {
      "enum": [
        "long",
        "short"
      ],
      "title": "TradeDirection",
      "type": "string"
    },
    "TrendPulseEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "observation_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Hash",
          "type": "string"
        },
        "observation_id": {
          "format": "uuid",
          "title": "Observation Id",
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Hash",
          "type": "string"
        },
        "timeframe": {
          "$ref": "#/$defs/Timeframe"
        }
      },
      "required": [
        "timeframe",
        "observation_id",
        "payload_hash",
        "observation_hash",
        "available_at"
      ],
      "title": "TrendPulseEvidenceReference",
      "type": "object"
    },
    "TrendPulseParameters": {
      "additionalProperties": false,
      "description": "Fixed baseline. Changing any rule requires a separately reviewed version.",
      "properties": {
        "entry_history_bars": {
          "const": 60,
          "default": 60,
          "title": "Entry History Bars",
          "type": "integer"
        },
        "expiry_seconds": {
          "const": 60,
          "default": 60,
          "title": "Expiry Seconds",
          "type": "integer"
        },
        "fast_ema_period": {
          "const": 20,
          "default": 20,
          "title": "Fast Ema Period",
          "type": "integer"
        },
        "maximum_entry_rounding_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.001",
          "gt": 0,
          "title": "Maximum Entry Rounding Ratio"
        },
        "maximum_pullback_penetration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.003",
          "gt": 0,
          "title": "Maximum Pullback Penetration"
        },
        "maximum_risk_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.02",
          "gt": 0,
          "title": "Maximum Risk Ratio"
        },
        "maximum_trigger_open_gap_ratio": {
          "anyOf": [
            {
