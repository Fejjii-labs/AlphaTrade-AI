{
  "$defs": {
    "ContractStyle": {
      "enum": [
        "linear",
        "inverse"
      ],
      "title": "ContractStyle",
      "type": "string"
    },
    "ContractType": {
      "enum": [
        "LINEAR",
        "INVERSE"
      ],
      "title": "ContractType",
      "type": "string"
    },
    "EvidenceMarketIdentity": {
      "additionalProperties": false,
      "description": "Full identity required on every first-slice evidence object.",
      "properties": {
        "instrument": {
          "$ref": "#/$defs/InstrumentIdentity"
        },
        "market_type": {
          "$ref": "#/$defs/MarketType"
        },
        "provenance": {
          "$ref": "#/$defs/ProviderProvenance"
        },
        "source": {
          "$ref": "#/$defs/SourceIdentity"
        },
        "timeframe": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timeframe"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "venue": {
          "$ref": "#/$defs/VenueId"
        }
      },
      "required": [
        "venue",
        "market_type",
        "instrument",
        "source",
        "provenance"
      ],
      "title": "EvidenceMarketIdentity",
      "type": "object"
    },
    "ExperimentBoundTrendPulse": {
      "additionalProperties": false,
      "properties": {
        "account_verified_here": {
          "const": false,
          "default": false,
          "title": "Account Verified Here",
          "type": "boolean"
        },
        "binding_id": {
          "format": "uuid",
          "title": "Binding Id",
          "type": "string"
        },
        "configuration_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Hash",
          "type": "string"
        },
        "contract_version": {
          "const": "trendpulse-experiment-research/v1",
          "default": "trendpulse-experiment-research/v1",
          "title": "Contract Version",
          "type": "string"
        },
        "declared_execution_account_id": {
          "format": "uuid",
          "title": "Declared Execution Account Id",
          "type": "string"
        },
        "declared_execution_source": {
          "$ref": "#/$defs/ExperimentSource"
        },
        "declared_native_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Declared Native Uid"
        },
        "experiment_id": {
          "format": "uuid",
          "title": "Experiment Id",
          "type": "string"
        },
        "experiment_version_id": {
          "format": "uuid",
          "title": "Experiment Version Id",
          "type": "string"
        },
        "native_execution": {
          "const": false,
          "default": false,
          "title": "Native Execution",
          "type": "boolean"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        },
        "performance": {
          "default": null,
          "title": "Performance",
          "type": "null"
        },
        "runtime_activated": {
          "const": false,
          "default": false,
          "title": "Runtime Activated",
          "type": "boolean"
        },
        "sample_eligible": {
          "const": false,
          "default": false,
          "title": "Sample Eligible",
          "type": "boolean"
        },
        "sample_group_id": {
          "format": "uuid",
          "title": "Sample Group Id",
          "type": "string"
        },
        "signal": {
          "$ref": "#/$defs/TrendPulseSignal"
        },
        "strategy_content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Strategy Content Hash",
          "type": "string"
        },
        "strategy_id": {
          "format": "uuid",
          "title": "Strategy Id",
          "type": "string"
        },
        "strategy_version_id": {
          "format": "uuid",
          "title": "Strategy Version Id",
          "type": "string"
        },
        "variant_key": {
          "title": "Variant Key",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "organization_id",
        "experiment_id",
        "experiment_version_id",
        "configuration_hash",
        "sample_group_id",
        "variant_key",
        "strategy_id",
        "strategy_version_id",
        "strategy_content_hash",
        "declared_execution_source",
        "declared_execution_account_id",
        "declared_native_uid",
        "signal"
      ],
      "title": "ExperimentBoundTrendPulse",
      "type": "object"
    },
    "ExperimentSource": {
      "enum": [
        "blofin_demo",
        "internal_simulation"
      ],
      "title": "ExperimentSource",
      "type": "string"
    },
    "Finality": {
      "enum": [
        "final",
        "forming",
        "corrected",
        "unknown"
      ],
      "title": "Finality",
      "type": "string"
    },
    "FreshnessState": {
      "enum": [
        "fresh",
        "aging",
        "stale",
        "gap",
        "unknown"
      ],
      "title": "FreshnessState",
      "type": "string"
    },
    "InstrumentIdentity": {
      "additionalProperties": false,
      "description": "Canonical perpetual instrument identity; independent of provider symbol formatting.",
      "properties": {
        "base_asset": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Base Asset",
          "type": "string"
        },
        "base_quantity_unit": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Base Quantity Unit",
          "type": "string"
        },
        "contract_multiplier": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "gt": 0,
          "title": "Contract Multiplier"
        },
        "contract_style": {
          "$ref": "#/$defs/ContractStyle"
        },
        "instrument_id": {
          "maxLength": 80,
          "minLength": 8,
          "title": "Instrument Id",
          "type": "string"
        },
        "market_type": {
          "$ref": "#/$defs/MarketType"
        },
        "price_unit": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Price Unit",
          "type": "string"
        },
        "product_family": {
          "$ref": "#/$defs/ProductFamily"
        },
        "provider_symbol": {
          "maxLength": 32,
          "minLength": 2,
          "title": "Provider Symbol",
          "type": "string"
        },
        "quote_asset": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Quote Asset",
          "type": "string"
        },
        "quote_quantity_unit": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Quote Quantity Unit",
          "type": "string"
        },
        "settlement_asset": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Settlement Asset",
          "type": "string"
        },
        "venue": {
          "$ref": "#/$defs/VenueId"
        }
      },
      "required": [
        "venue",
        "market_type",
        "product_family",
        "contract_style",
        "instrument_id",
        "provider_symbol",
        "base_asset",
        "quote_asset",
        "settlement_asset",
        "contract_multiplier",
        "price_unit",
        "base_quantity_unit",
        "quote_quantity_unit"
      ],
      "title": "InstrumentIdentity",
      "type": "object"
    },
    "InstrumentRules": {
      "additionalProperties": false,
      "properties": {
        "base_currency": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Base Currency",
          "type": "string"
        },
        "contract_multiplier": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "gt": 0,
          "title": "Contract Multiplier"
        },
        "contract_type": {
          "$ref": "#/$defs/ContractType"
        },
        "lot_size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "gt": 0,
          "title": "Lot Size"
        },
        "minimum_notional": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Minimum Notional"
        },
        "minimum_quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "gt": 0,
          "title": "Minimum Quantity"
        },
        "quote_currency": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Quote Currency",
          "type": "string"
        },
        "rules_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Rules Version",
          "type": "string"
        },
        "settlement_currency": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Settlement Currency",
          "type": "string"
        },
        "tick_size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "gt": 0,
          "title": "Tick Size"
        }
      },
      "required": [
        "contract_multiplier",
        "contract_type",
        "base_currency",
        "quote_currency",
        "settlement_currency",
        "tick_size",
        "lot_size",
        "minimum_quantity",
        "minimum_notional",
        "rules_version"
      ],
      "title": "InstrumentRules",
      "type": "object"
    },
    "MarketType": {
      "enum": [
        "perpetual",
        "spot",
        "delivery",
        "coin_m_perpetual",
        "option"
      ],
      "title": "MarketType",
      "type": "string"
    },
    "ObservationType": {
      "enum": [
        "ohlcv",
        "trade",
        "cvd",
        "order_book",
        "volume",
        "structure",
        "open_interest",
        "funding"
      ],
      "title": "ObservationType",
      "type": "string"
    },
    "OhlcvBar": {
      "additionalProperties": false,
      "description": "One venue kline after normalization.",
      "properties": {
        "adapter_version": {
          "maxLength": 80,
          "minLength": 3,
          "title": "Adapter Version",
          "type": "string"
        },
        "base_volume": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Base Volume"
        },
        "close": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "gt": 0,
          "title": "Close"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "finality": {
          "$ref": "#/$defs/Finality"
        },
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "gt": 0,
          "title": "High"
        },
        "instrument": {
          "$ref": "#/$defs/InstrumentIdentity"
        },
        "interval_end": {
          "format": "date-time",
          "title": "Interval End",
          "type": "string"
        },
        "interval_start": {
          "format": "date-time",
          "title": "Interval Start",
          "type": "string"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "gt": 0,
          "title": "Low"
        },
        "open": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "gt": 0,
          "title": "Open"
        },
        "provider_complete": {
          "title": "Provider Complete",
          "type": "boolean"
        },
        "quote_volume": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": 0,
          "title": "Quote Volume"
        },
        "revision": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "source_event_id": {
          "maxLength": 80,
          "minLength": 3,
          "title": "Source Event Id",
          "type": "string"
        },
        "source_time": {
          "format": "date-time",
          "title": "Source Time",
          "type": "string"
        },
        "timeframe": {
          "$ref": "#/$defs/Timeframe"
        },
        "trade_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trade Count"
        }
      },
      "required": [
        "instrument",
        "timeframe",
        "interval_start",
        "interval_end",
        "open",
        "high",
        "low",
        "close",
        "base_volume",
        "quote_volume",
        "source_event_id",
        "provider_complete",
        "finality",
        "revision",
        "source_time",
        "adapter_version",
        "content_hash"
      ],
      "title": "OhlcvBar",
      "type": "object"
    },
    "PrivacyClass": {
      "enum": [
        "public_market_data"
      ],
      "title": "PrivacyClass",
      "type": "string"
    },
    "ProductFamily": {
      "enum": [
        "usdm_futures",
        "coinm_futures",
        "spot"
      ],
      "title": "ProductFamily",
      "type": "string"
    },
    "ProviderProvenance": {
      "additionalProperties": false,
