      "title": "Organization Id",
      "type": "string"
    },
    "budget_reference": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Budget Reference",
      "type": "string"
    },
    "budget_as_of": {
      "format": "date-time",
      "title": "Budget As Of",
      "type": "string"
    },
    "valid_until": {
      "format": "date-time",
      "title": "Valid Until",
      "type": "string"
    },
    "remaining_budget_usd": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Remaining Budget Usd"
    },
    "session_ceiling_usd": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
