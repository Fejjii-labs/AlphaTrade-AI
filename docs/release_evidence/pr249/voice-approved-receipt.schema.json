{
  "$defs": {
    "EmbeddingPrice": {
      "additionalProperties": false,
      "description": "Optional operator-verified receipt for the existing embedding route.",
      "properties": {
        "model": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "source": {
          "maxLength": 500,
          "pattern": "^https://",
          "title": "Source",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "maximum_input_tokens": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Maximum Input Tokens",
          "type": "integer"
        },
        "input_usd_per_million": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Input Usd Per Million"
        }
      },
      "required": [
        "model",
        "source",
        "valid_until",
        "maximum_input_tokens",
        "input_usd_per_million"
      ],
      "title": "EmbeddingPrice",
      "type": "object"
    },
