    "maximum_seconds": {
      "default": 180,
      "maximum": 300,
      "minimum": 10,
      "title": "Maximum Seconds",
      "type": "integer"
    },
    "maximum_audio_seconds": {
      "default": 90,
      "maximum": 180,
      "minimum": 1,
      "title": "Maximum Audio Seconds",
      "type": "integer"
    },
    "maximum_turns": {
      "default": 6,
      "maximum": 12,
      "minimum": 1,
      "title": "Maximum Turns",
      "type": "integer"
    },
    "maximum_responses": {
      "default": 12,
      "maximum": 24,
      "minimum": 2,
      "title": "Maximum Responses",
      "type": "integer"
    },
    "maximum_output_tokens": {
      "default": 1024,
      "maximum": 4096,
      "minimum": 64,
      "title": "Maximum Output Tokens",
      "type": "integer"
