# ---------------------------------------------------------------------------
# AlphaTrade AI — production environment template
# Copy values to platform secret store. DO NOT commit filled files.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="AlphaTrade AI"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://app.yourdomain.com
# AT-018: number of trusted reverse proxies in front of the app (must be >= 1).
TRUSTED_PROXY_HOPS=1

# --- Trading safety (required — paper-only until explicit live-trading slice) ---
EXECUTION_MODE=paper
ENABLE_REAL_TRADING=false

# --- Watcher orchestration (disabled; no automatic scans or candidates) ---
MARKET_WATCHER_ENABLED=false
MARKET_WATCHER_BRIDGE_ENABLED=false
WATCHER_ORCHESTRATION_ENABLED=false

# --- Telegram / outbound alerts (disabled) ---
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_INTERACTION_ENABLED=false
AUTOMATIC_TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_PAPER_ACTIVATION_ARMED=false
TELEGRAM_INBOUND_MODE=off
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_NETWORK_PERMITTED=false
TELEGRAM_BOT_ID=
TELEGRAM_CHAT_ID=
EMAIL_ALERTS_ENABLED=false
ALERT_DELIVERY_ENABLED=false
ENABLE_PAPER_SCHEDULER=false
PAPER_SIGNAL_ORCHESTRATION_ENABLED=false
TRADINGVIEW_WEBHOOK_ENABLED=false
WORKER_ENABLED=false

# --- Managed data stores ---
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/alphatrade
REDIS_URL=redis://:PASSWORD@HOST:6379/0
QDRANT_URL=https://YOUR-CLUSTER.qdrant.io
QDRANT_API_KEY=

# --- Providers ---
PROVIDER_MODE=fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_TIER_A_MODEL=gpt-6.1-sol
LLM_TIER_B_MODEL=gpt-6-luna
MODEL_ROUTER_POLICY_VERSION=model-router/v1
MODEL_ROUTER_FAIL_CLOSED=false
EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_DIMENSIONS=1536

# --- Market data (read-only) ---
MARKET_DATA_ENABLED=true
MARKET_DATA_PROVIDER=binance
MARKET_DATA_CACHE_USE_REDIS=true
# Production stays on replay. Staging read-only USD-M activation is a separate
# change and is refused when ENVIRONMENT=production.
PERPETUAL_EVIDENCE_SOURCE=replay
PERPETUAL_EVIDENCE_TIMEOUT_SECONDS=10
PERPETUAL_MONITOR_POLL_SECONDS=2
PERPETUAL_MONITOR_BACKOFF_INITIAL_SECONDS=0.25
PERPETUAL_MONITOR_BACKOFF_MAX_SECONDS=30
# API serves the worker-persisted monitor row; older rows read as stale.
MARKET_MONITOR_SNAPSHOT_STALE_AFTER_SECONDS=60

# --- Observability ---
OBSERVABILITY_STRICT_MODE=true
# AT-016: never enable without METRICS_SCRAPE_TOKEN
METRICS_ENABLED=false
METRICS_SCRAPE_TOKEN=
LANGSMITH_API_KEY=

# --- Authentication (HTTPS cookie mode — required) ---
JWT_SECRET=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_REFRESH_COOKIE_ENABLED=true
AUTH_OMIT_REFRESH_FROM_BODY=true
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
ACCESS_TOKEN_DENYLIST_ENABLED=true
ACCESS_TOKEN_DENYLIST_USE_REDIS=true
# AT-018: revocation checks/writes fail closed when Redis is unavailable.
ACCESS_TOKEN_DENYLIST_FAIL_CLOSED=true

# --- Rate limiting (AT-018: Redis mandatory, no memory fallback) ---
RATE_LIMIT_USE_REDIS=true
RATE_LIMIT_ALLOW_IN_MEMORY_FALLBACK=false
