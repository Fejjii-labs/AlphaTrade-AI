{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fejjii-labs/AlphaTrade-AI/scripts/agent_reporting/agent_completion.schema.json",
  "title": "AlphaTrade AI agent completion report",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "findings", "fixes", "solutions", "blockers", "tests", "next_step", "final_output"],
  "properties": {
    "status": {"type": "string", "enum": ["complete", "blocked", "failed"]},
    "findings": {"type": "array", "items": {"type": "string"}},
    "fixes": {"type": "array", "items": {"type": "string"}},
    "solutions": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "items": {"type": "string"}},
    "next_step": {"type": "string"},
    "final_output": {"type": "string"}
  }
}
